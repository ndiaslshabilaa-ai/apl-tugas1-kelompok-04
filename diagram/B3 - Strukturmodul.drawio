        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam DefaultTextAlignment center\nskinparam RectangleBackgroundColor #FFFFFF\nskinparam RectangleBorderColor #333333\nskinparam ArrowColor #666666\n\ntitle Struktur Modul: Unit Kode dan Hubungan \&quot;Menggunakan\&quot;\\nLayanan Tugas Akhir (Subsistem Assignment &amp; Assessment)\n\npackage \&quot;Lapisan Tampilan (Presentation Layer)\&quot; #EBF1F5 {\n    [Halaman Pengajuan Judul] as P1\n    [Halaman Logbook Bimbingan] as P2\n    [Form Penilaian Sidang] as P3\n}\n\npackage \&quot;Lapisan Logika Bisnis (Business Logic Layer)\&quot; #DDEBF7 {\n    [Pengelola Tugas Akhir] as L1\n    [Validasi Syarat SKS &amp; Kuota] as L2\n    [Penjadwalan Sidang] as L3\n}\n\npackage \&quot;Lapisan Data (Data Access Layer)\&quot; #FCE4D6 {\n    [Repositori Dokumen Skripsi] as D1\n    [Repositori Nilai Akademik] as D2\n}\n\n&#39; Hubungan antar modul (menggunakan)\nP1 --&gt; L1\nP2 --&gt; L1\nP3 --&gt; L1\n\nL1 --&gt; L2\nL1 --&gt; L3\n\nL2 --&gt; D1\nL3 --&gt; D1\nL3 --&gt; D2\n\nnote bottom of P1\n  &lt;b&gt;Cara Membaca:&lt;/b&gt; Panah A --&gt; B berarti \&quot;modul A menggunakan modul B\&quot;. \n  Panah tidak boleh naik ke lapisan di atasnya.\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="pmSYfO8ic3w5B_-W7ML0-1">
